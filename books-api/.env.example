# Copy this to .env and fill in real values — NEVER commit .env to git
# Generate a strong JWT_SECRET: openssl rand -base64 48

# --- Required in production ---
JWT_SECRET=replace-me-with-base64-encoded-random-minimum-32-bytes

# --- Database (production / Docker Compose) ---
DATABASE_URL=jdbc:postgresql://localhost:5432/booksdb
DATABASE_USERNAME=books_user
DATABASE_PASSWORD=replace-me-with-strong-password

# --- Optional overrides ---
PORT=8080
SPRING_PROFILES_ACTIVE=prod

# --- Allowed CORS origins (comma-separated) ---
# CORS_ALLOWED_ORIGINS=https://yourdomain.com
